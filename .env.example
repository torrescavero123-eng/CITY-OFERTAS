APP_NAME="CITY OFERTAS WMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Migraciones: propietario (wms_owner). En producción la app corre como wms_app (ver docker-compose).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wms
DB_USERNAME=wms_owner
DB_PASSWORD=wms_owner_dev

SESSION_DRIVER=database
SESSION_LIFETIME=30
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
BCRYPT_ROUNDS=12

OCTANE_SERVER=frankenphp

# Contraseñas con argon2id (recomendado por OWASP)
HASH_DRIVER=argon2id

# Primer administrador (solo para `php artisan db:seed`; mínimo 12 caracteres en la contraseña)
# WMS_ADMIN_USERNAME=admin
# WMS_ADMIN_EMAIL=admin@cityofertas.pe
# WMS_ADMIN_PASSWORD=
